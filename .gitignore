data/
**/*.ipynb_checkpoints/
logs/
*.pyc
__pycache__/
*.pyo
*.pyd
.env
.claude/*
.claude/settings.local.json
# review-core lens pack is versioned; its reports are not
!.claude/review/
.claude/review/out/
# Shared hook registration, hook scripts and rule files are versioned; personal permissions live
# in settings.local.json, and .claude/state/ (hook run state) stays ignored.
!.claude/settings.json
!.claude/hooks/
!.claude/rules/
# Test-first pack (tdd-spec) is versioned; its local gate cache is not
!.claude/tdd/
.claude/tdd/state/
