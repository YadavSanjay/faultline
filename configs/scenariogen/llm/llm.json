{
  "active_profile": "${SCENARIOGEN_LLM_PROFILE:-openai}",
  "providers": {
    "openai": {"api_key_env": "OPENAI_API_KEY", "timeout_s": 600},
    "anthropic": {"api_key_env": "ANTHROPIC_API_KEY", "timeout_s": 600},
    "deepseek": {"api_key_env": "DEEPSEEK_API_KEY", "timeout_s": 600, "base_url": "https://api.deepseek.com"}
  },
  "models": {
    "gpt-5": {"provider": "openai", "max_output_tokens": 128000, "json_mode": "json_object"},
    "gpt-5-mini": {"provider": "openai", "max_output_tokens": 128000, "json_mode": "json_object"},
    "gpt-5-nano": {"provider": "openai", "max_output_tokens": 128000, "json_mode": "json_object"},
    "claude-sonnet-5-5": {"provider": "anthropic", "max_output_tokens": 128000, "json_mode": "json_schema",
                          "temperature": false, "thinking": "adaptive", "effort": "high"},
    "claude-haiku-5-5": {"provider": "anthropic", "max_output_tokens": 128000, "json_mode": "json_schema",
                         "temperature": false, "thinking": "adaptive", "effort": "medium"},
    "deepseek-flash": {"provider": "deepseek", "max_output_tokens": 384000, "json_mode": "json_object",
                       "temperature": false, "effort": "high"},
    "deepseek-v4-pro": {"provider": "deepseek", "max_output_tokens": 384000, "json_mode": "json_object",
                        "temperature": false, "effort": "high"}
  },
  "profiles": {
    "openai": {
      "discover": "gpt-5-nano",
      "evidence": "gpt-5-mini",
      "propose": "gpt-5",
      "calibrate": "gpt-5-mini",
      "narrate": "gpt-5-mini",
      "verify": "gpt-5-nano",
      "attribution": "gpt-5-mini"
    },
    "anthropic": {
      "discover": "claude-haiku-5-5",
      "evidence": "claude-haiku-5-5",
      "propose": "claude-sonnet-5-5",
      "calibrate": "claude-sonnet-5-5",
      "narrate": "claude-haiku-5-5",
      "verify": "claude-haiku-5-5",
      "attribution": "claude-haiku-5-5"
    },
    "deepseek": {
      "discover": "deepseek-flash",
      "evidence": "deepseek-flash",
      "propose": "deepseek-v4-pro",
      "calibrate": "deepseek-v4-pro",
      "narrate": "deepseek-flash",
      "verify": "deepseek-flash",
      "attribution": "deepseek-flash"
    }
  },
  "stage_params": {
    "discover": {"max_tokens": 8000},
    "evidence": {"max_tokens": 16000},
    "propose": {"max_tokens": 24000},
    "calibrate": {"max_tokens": 16000},
    "narrate": {"max_tokens": 16000},
    "verify": {"max_tokens": 8000},
    "attribution": {"max_tokens": 6000}
  },
  "retry": {"max_attempts": 4, "min_wait_s": 1.0, "max_wait_s": 30.0},
  "budgets": {"max_tool_calls_per_phase": 6, "max_total_cost_usd": 5.0, "max_scenarios": 10, "max_candidates": 10}
}
